# Raspberry Pi: startet den Controller beim Hochfahren und nach Fehlern neu.
#   sudo cp matrix-controller.service /etc/systemd/system/
#   sudo systemctl enable --now matrix-controller
# Benutzer und Pfad anpassen; für eine feste Adresse --app 192.168.1.20 anhängen.
[Unit]
Description=Matrix Games Gamepad-Controller
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Matrix-Games/fernsteuerung-controller
ExecStart=/usr/bin/python3 controller.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
